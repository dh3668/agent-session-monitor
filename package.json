{
  "name": "agent-session-monitor",
  "displayName": "%displayName%",
  "description": "%description%",
  "publisher": "local-tools",
  "version": "1.0.1",
  "icon": "media/icons/app.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dh3668/agent-session-monitor.git"
  },
  "homepage": "https://github.com/dh3668/agent-session-monitor#readme",
  "bugs": {
    "url": "https://github.com/dh3668/agent-session-monitor/issues"
  },
  "keywords": [
    "vscode",
    "claude-code",
    "codex",
    "antigravity",
    "ai-agent",
    "session-monitor",
    "macos",
    "linux"
  ],
  "engines": {
    "vscode": "^1.120.0"
  },
  "main": "./src/extension.cjs",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces%"
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Other"
  ],
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "package": "python3 scripts/package.py",
    "showcase": "node scripts/build-showcase.cjs",
    "build:notifier": "bash native/macos-notifier/build.sh"
  },
  "contributes": {
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "agentSessionMonitor.notifications": {
          "type": "string",
          "scope": "application",
          "default": "attentionAndDone",
          "enum": [
            "attentionAndDone",
            "attention",
            "off"
          ],
          "enumDescriptions": [
            "%config.notifications.attentionAndDone%",
            "%config.notifications.attention%",
            "%config.notifications.off%"
          ],
          "description": "%config.notifications.description%"
        },
        "agentSessionMonitor.chatLocation": {
          "type": "string",
          "scope": "application",
          "default": "secondarySidebar",
          "enum": [
            "secondarySidebar",
            "lastUsed"
          ],
          "enumDescriptions": [
            "%config.chatLocation.secondarySidebar%",
            "%config.chatLocation.lastUsed%"
          ],
          "description": "%config.chatLocation.description%"
        },
        "agentSessionMonitor.subscriptionUsage": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "description": "%config.subscriptionUsage.description%"
        },
        "agentSessionMonitor.inlineActions": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "description": "%config.inlineActions.description%"
        },
        "agentSessionMonitor.awayNotifications": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "description": "%config.awayNotifications.description%"
        },
        "agentSessionMonitor.notificationSound": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "description": "%config.notificationSound.description%"
        },
        "agentSessionMonitor.inlineActionSeconds": {
          "type": "number",
          "scope": "application",
          "default": 45,
          "minimum": 15,
          "maximum": 540,
          "description": "%config.inlineActionSeconds.description%"
        },
        "agentSessionMonitor.otherFolders": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "description": "%config.otherFolders.description%"
        },
        "agentSessionMonitor.activityDetail": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "description": "%config.activityDetail.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentSessionMonitor",
          "title": "%viewsContainers.sessions%",
          "icon": "media/sessions.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "agentSessionMonitorChats",
          "title": "%viewsContainers.chats%",
          "icon": "media/sessions.svg"
        }
      ]
    },
    "views": {
      "agentSessionMonitor": [
        {
          "id": "agentSessionMonitor.sessions",
          "name": "%views.sessions%",
          "icon": "media/sessions.svg",
          "type": "webview"
        }
      ],
      "agentSessionMonitorChats": [
        {
          "id": "agentSessionMonitor.chatPlaceholder",
          "name": "%views.chatPlaceholder%",
          "when": "false"
        }
      ]
    },
    "commands": [
      {
        "command": "agentSessionMonitor.connect",
        "title": "%command.connect%",
        "category": "%command.category%",
        "icon": "$(plug)"
      },
      {
        "command": "agentSessionMonitor.disconnect",
        "title": "%command.disconnect%",
        "category": "%command.category%"
      },
      {
        "command": "agentSessionMonitor.refresh",
        "title": "%command.refresh%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "agentSessionMonitor.open",
        "title": "%command.open%",
        "category": "%command.category%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "agentSessionMonitor.rename",
        "title": "%command.rename%",
        "category": "%command.category%",
        "icon": "$(edit)"
      },
      {
        "command": "agentSessionMonitor.dismiss",
        "title": "%command.dismiss%",
        "category": "%command.category%",
        "icon": "$(check)"
      },
      {
        "command": "agentSessionMonitor.switchSession",
        "title": "%command.switchSession%",
        "category": "%command.category%",
        "icon": "$(list-selection)"
      },
      {
        "command": "agentSessionMonitor.nextAttention",
        "title": "%command.nextAttention%",
        "category": "%command.category%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "agentSessionMonitor.previousSession",
        "title": "%command.previousSession%",
        "category": "%command.category%",
        "icon": "$(history)"
      },
      {
        "command": "agentSessionMonitor.markAllSeen",
        "title": "%command.markAllSeen%",
        "category": "%command.category%",
        "icon": "$(check-all)"
      },
      {
        "command": "agentSessionMonitor.allowOpenRequest",
        "title": "%command.allowOpenRequest%",
        "category": "%command.category%",
        "icon": "$(check)"
      },
      {
        "command": "agentSessionMonitor.denyOpenRequest",
        "title": "%command.denyOpenRequest%",
        "category": "%command.category%",
        "icon": "$(close)"
      },
      {
        "command": "agentSessionMonitor.newSession",
        "title": "%command.newSession%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "agentSessionMonitor.arrange",
        "title": "%command.arrange%",
        "category": "%command.category%",
        "icon": "$(list-filter)"
      },
      {
        "command": "agentSessionMonitor.testNotification",
        "title": "%command.testNotification%",
        "category": "%command.category%",
        "icon": "$(bell)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentSessionMonitor.newSession",
          "when": "view == agentSessionMonitor.sessions",
          "group": "navigation@0"
        },
        {
          "command": "agentSessionMonitor.nextAttention",
          "when": "view == agentSessionMonitor.sessions",
          "group": "navigation@1"
        },
        {
          "command": "agentSessionMonitor.switchSession",
          "when": "view == agentSessionMonitor.sessions",
          "group": "navigation@2"
        },
        {
          "command": "agentSessionMonitor.arrange",
          "when": "view == agentSessionMonitor.sessions",
          "group": "navigation@3"
        },
        {
          "command": "agentSessionMonitor.markAllSeen",
          "when": "view == agentSessionMonitor.sessions",
          "group": "1_more@0"
        },
        {
          "command": "agentSessionMonitor.previousSession",
          "when": "view == agentSessionMonitor.sessions",
          "group": "1_more@1"
        },
        {
          "command": "agentSessionMonitor.refresh",
          "when": "view == agentSessionMonitor.sessions",
          "group": "1_more@2"
        },
        {
          "command": "agentSessionMonitor.connect",
          "when": "view == agentSessionMonitor.sessions",
          "group": "2_more@3"
        },
        {
          "command": "agentSessionMonitor.disconnect",
          "when": "view == agentSessionMonitor.sessions",
          "group": "2_more@4"
        },
        {
          "command": "agentSessionMonitor.testNotification",
          "when": "view == agentSessionMonitor.sessions",
          "group": "2_more@5"
        }
      ],
      "commandPalette": [
        {
          "command": "agentSessionMonitor.open",
          "when": "false"
        },
        {
          "command": "agentSessionMonitor.rename",
          "when": "false"
        },
        {
          "command": "agentSessionMonitor.dismiss",
          "when": "false"
        },
        {
          "command": "agentSessionMonitor.allowOpenRequest",
          "when": "agentSessionMonitor.openRequest"
        },
        {
          "command": "agentSessionMonitor.denyOpenRequest",
          "when": "agentSessionMonitor.openRequest"
        }
      ],
      "webview/context": [
        {
          "command": "agentSessionMonitor.open",
          "when": "webviewSection == 'agentSession' && sessionOpens",
          "group": "1_session@0"
        },
        {
          "command": "agentSessionMonitor.rename",
          "when": "webviewSection == 'agentSession'",
          "group": "1_session@1"
        },
        {
          "command": "agentSessionMonitor.dismiss",
          "when": "webviewSection == 'agentSession' && sessionSettled",
          "group": "1_session@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agentSessionMonitor.nextAttention",
        "key": "ctrl+alt+n",
        "mac": "ctrl+cmd+n"
      },
      {
        "command": "agentSessionMonitor.previousSession",
        "key": "ctrl+alt+b",
        "mac": "ctrl+cmd+b"
      },
      {
        "command": "agentSessionMonitor.switchSession",
        "key": "ctrl+alt+l",
        "mac": "ctrl+cmd+l"
      },
      {
        "command": "agentSessionMonitor.sessions.focus",
        "key": "ctrl+alt+a",
        "mac": "ctrl+cmd+a"
      },
      {
        "command": "agentSessionMonitor.allowOpenRequest",
        "key": "ctrl+alt+enter",
        "mac": "ctrl+cmd+enter",
        "when": "agentSessionMonitor.openRequest == 'approval' || agentSessionMonitor.openRequest == 'question'"
      },
      {
        "command": "agentSessionMonitor.denyOpenRequest",
        "key": "ctrl+alt+backspace",
        "mac": "ctrl+cmd+backspace",
        "when": "agentSessionMonitor.openRequest == 'approval'"
      }
    ]
  }
}
