{
  "name": "agent-session-monitor",
  "displayName": "에이전트 세션 모니터",
  "description": "현재 작업 폴더의 Claude Code · Codex · Antigravity 세션을 한 사이드바에서 모니터링하고 승인·질문·작업 흐름·구독 한도를 관리합니다.",
  "publisher": "local-tools",
  "version": "1.0.1",
  "icon": "media/icons/app.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dh3668/agent-session-monitor.git"
  },
  "homepage": "https://github.com/dh3668/agent-session-monitor#readme",
  "bugs": {
    "url": "https://github.com/dh3668/agent-session-monitor/issues"
  },
  "keywords": [
    "vscode",
    "claude-code",
    "codex",
    "antigravity",
    "ai-agent",
    "session-monitor",
    "macos",
    "linux"
  ],
  "engines": {
    "vscode": "^1.120.0"
  },
  "main": "./src/extension.cjs",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "제한된 작업 영역에서는 세션 목록만 읽기 전용으로 표시하며 훅 활동 수집, 인라인 승인, 구독 한도 조회는 비활성화됩니다."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Other"
  ],
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "package": "python3 scripts/package.py",
    "showcase": "node scripts/build-showcase.cjs",
    "build:notifier": "bash native/macos-notifier/build.sh"
  },
  "contributes": {
    "configuration": {
      "title": "에이전트 세션 모니터",
      "properties": {
        "agentSessionMonitor.notifications": {
          "type": "string",
          "scope": "application",
          "default": "attentionAndDone",
          "enum": [
            "attentionAndDone",
            "attention",
            "off"
          ],
          "enumDescriptions": [
            "승인·답변 대기, 오류 및 응답 완료",
            "승인·답변 대기 및 오류",
            "목록과 상태 바만 갱신"
          ],
          "description": "세션 알림의 범위를 선택합니다. 사용 중인 창에는 VS Code 알림으로, 창을 벗어나 있을 때는 macOS 알림으로 전달합니다."
        },
        "agentSessionMonitor.chatLocation": {
          "type": "string",
          "scope": "application",
          "default": "secondarySidebar",
          "enum": [
            "secondarySidebar",
            "lastUsed"
          ],
          "enumDescriptions": [
            "대화를 보조 사이드바에 표시",
            "도구에서 마지막으로 사용한 위치 이용"
          ],
          "description": "세션 제목이나 새 대화 버튼을 눌렀을 때 열 위치입니다."
        },
        "agentSessionMonitor.subscriptionUsage": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "description": "패널을 보는 동안 로그인한 공식 도구의 구독 사용률과 리셋 시각을 조회합니다. 자동 조회 간격은 도구별 5분입니다."
        },
        "agentSessionMonitor.inlineActions": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "description": "에이전트 세션 모니터 패널을 보고 있을 때 VS Code 확장의 메인 Claude Code 세션에서 발생한 승인 요청과 선택형 질문(여러 질문·복수 선택 포함)을 여기에서 처리합니다. Codex·Antigravity·서브에이전트·계획 승인은 읽기 전용 미리보기 후 채팅에서 처리합니다."
        },
        "agentSessionMonitor.awayNotifications": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "description": "VS Code 창이 비활성 상태일 때 승인·답변 대기와 오류, 새 응답을 에이전트 로고와 함께 macOS 네이티브 알림으로 전달합니다. 알림을 누르면 해당 프로젝트의 VS Code 창으로 바로 이동합니다."
        },
        "agentSessionMonitor.notificationSound": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "description": "macOS 네이티브 알림 표시 시 시스템 알림음을 재생합니다."
        },
        "agentSessionMonitor.inlineActionSeconds": {
          "type": "number",
          "scope": "application",
          "default": 45,
          "minimum": 15,
          "maximum": 540,
          "description": "Claude Code의 승인 요청과 질문을 이 패널에서 바로 선택할 수 있는 시간(초)입니다. 시간이 지나면 공식 채팅에서 처리합니다."
        },
        "agentSessionMonitor.otherFolders": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "description": "이 창에 열지 않은 다른 작업 폴더에서 승인·답변을 기다리는 세션 수를 목록 아래에 표시합니다."
        },
        "agentSessionMonitor.activityDetail": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "description": "각 세션의 요청, 계획 체크리스트, 실행 단계, 변경 파일 목록, 마지막 응답 요약을 표시합니다. 확장 스냅샷 디스크에는 기록하지 않으며 메모리에만 유지합니다(단, awayNotifications가 켜져 있으면 비활성 창 macOS 알림 본문에 짧은 요약이 포함됩니다)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentSessionMonitor",
          "title": "에이전트 세션 모니터",
          "icon": "media/sessions.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "agentSessionMonitorChats",
          "title": "에이전트 대화",
          "icon": "media/sessions.svg"
        }
      ]
    },
    "views": {
      "agentSessionMonitor": [
        {
          "id": "agentSessionMonitor.sessions",
          "name": "세션 현황",
          "icon": "media/sessions.svg",
          "type": "webview"
        }
      ],
      "agentSessionMonitorChats": [
        {
          "id": "agentSessionMonitor.chatPlaceholder",
          "name": "대화",
          "when": "false"
        }
      ]
    },
    "commands": [
      {
        "command": "agentSessionMonitor.connect",
        "title": "에이전트 연결",
        "category": "에이전트 세션 모니터",
        "icon": "$(plug)"
      },
      {
        "command": "agentSessionMonitor.disconnect",
        "title": "에이전트 연결 해제",
        "category": "에이전트 세션 모니터"
      },
      {
        "command": "agentSessionMonitor.refresh",
        "title": "새로 고침",
        "category": "에이전트 세션 모니터",
        "icon": "$(refresh)"
      },
      {
        "command": "agentSessionMonitor.open",
        "title": "대화 열기",
        "category": "에이전트 세션 모니터",
        "icon": "$(go-to-file)"
      },
      {
        "command": "agentSessionMonitor.rename",
        "title": "표시 이름 변경",
        "category": "에이전트 세션 모니터",
        "icon": "$(edit)"
      },
      {
        "command": "agentSessionMonitor.dismiss",
        "title": "세션 숨기기",
        "category": "에이전트 세션 모니터",
        "icon": "$(check)"
      },
      {
        "command": "agentSessionMonitor.switchSession",
        "title": "현재 폴더의 세션 전환",
        "category": "에이전트 세션 모니터",
        "icon": "$(list-selection)"
      },
      {
        "command": "agentSessionMonitor.nextAttention",
        "title": "다음 확인할 세션",
        "category": "에이전트 세션 모니터",
        "icon": "$(arrow-right)"
      },
      {
        "command": "agentSessionMonitor.previousSession",
        "title": "직전에 연 대화로 돌아가기",
        "category": "에이전트 세션 모니터",
        "icon": "$(history)"
      },
      {
        "command": "agentSessionMonitor.markAllSeen",
        "title": "새 응답 모두 읽음 표시",
        "category": "에이전트 세션 모니터",
        "icon": "$(check-all)"
      },
      {
        "command": "agentSessionMonitor.allowOpenRequest",
        "title": "열린 요청 허용 또는 답변 보내기",
        "category": "에이전트 세션 모니터",
        "icon": "$(check)"
      },
      {
        "command": "agentSessionMonitor.denyOpenRequest",
        "title": "열린 요청 거절",
        "category": "에이전트 세션 모니터",
        "icon": "$(close)"
      },
      {
        "command": "agentSessionMonitor.newSession",
        "title": "새 세션 시작",
        "category": "에이전트 세션 모니터",
        "icon": "$(add)"
      },
      {
        "command": "agentSessionMonitor.arrange",
        "title": "정렬 및 필터",
        "category": "에이전트 세션 모니터",
        "icon": "$(list-filter)"
      },
      {
        "command": "agentSessionMonitor.testNotification",
        "title": "알림 테스트",
        "category": "에이전트 세션 모니터",
        "icon": "$(bell)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentSessionMonitor.newSession",
          "when": "view == agentSessionMonitor.sessions",
          "group": "navigation@0"
        },
        {
          "command": "agentSessionMonitor.nextAttention",
          "when": "view == agentSessionMonitor.sessions",
          "group": "navigation@1"
        },
        {
          "command": "agentSessionMonitor.switchSession",
          "when": "view == agentSessionMonitor.sessions",
          "group": "navigation@2"
        },
        {
          "command": "agentSessionMonitor.arrange",
          "when": "view == agentSessionMonitor.sessions",
          "group": "navigation@3"
        },
        {
          "command": "agentSessionMonitor.markAllSeen",
          "when": "view == agentSessionMonitor.sessions",
          "group": "1_more@0"
        },
        {
          "command": "agentSessionMonitor.previousSession",
          "when": "view == agentSessionMonitor.sessions",
          "group": "1_more@1"
        },
        {
          "command": "agentSessionMonitor.refresh",
          "when": "view == agentSessionMonitor.sessions",
          "group": "1_more@2"
        },
        {
          "command": "agentSessionMonitor.connect",
          "when": "view == agentSessionMonitor.sessions",
          "group": "2_more@3"
        },
        {
          "command": "agentSessionMonitor.disconnect",
          "when": "view == agentSessionMonitor.sessions",
          "group": "2_more@4"
        },
        {
          "command": "agentSessionMonitor.testNotification",
          "when": "view == agentSessionMonitor.sessions",
          "group": "2_more@5"
        }
      ],
      "commandPalette": [
        {
          "command": "agentSessionMonitor.open",
          "when": "false"
        },
        {
          "command": "agentSessionMonitor.rename",
          "when": "false"
        },
        {
          "command": "agentSessionMonitor.dismiss",
          "when": "false"
        },
        {
          "command": "agentSessionMonitor.allowOpenRequest",
          "when": "agentSessionMonitor.openRequest"
        },
        {
          "command": "agentSessionMonitor.denyOpenRequest",
          "when": "agentSessionMonitor.openRequest"
        }
      ],
      "webview/context": [
        {
          "command": "agentSessionMonitor.open",
          "when": "webviewSection == 'agentSession' && sessionOpens",
          "group": "1_session@0"
        },
        {
          "command": "agentSessionMonitor.rename",
          "when": "webviewSection == 'agentSession'",
          "group": "1_session@1"
        },
        {
          "command": "agentSessionMonitor.dismiss",
          "when": "webviewSection == 'agentSession' && sessionSettled",
          "group": "1_session@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agentSessionMonitor.nextAttention",
        "key": "ctrl+alt+n",
        "mac": "ctrl+cmd+n"
      },
      {
        "command": "agentSessionMonitor.previousSession",
        "key": "ctrl+alt+b",
        "mac": "ctrl+cmd+b"
      },
      {
        "command": "agentSessionMonitor.switchSession",
        "key": "ctrl+alt+l",
        "mac": "ctrl+cmd+l"
      },
      {
        "command": "agentSessionMonitor.sessions.focus",
        "key": "ctrl+alt+a",
        "mac": "ctrl+cmd+a"
      },
      {
        "command": "agentSessionMonitor.allowOpenRequest",
        "key": "ctrl+alt+enter",
        "mac": "ctrl+cmd+enter",
        "when": "agentSessionMonitor.openRequest == 'approval' || agentSessionMonitor.openRequest == 'question'"
      },
      {
        "command": "agentSessionMonitor.denyOpenRequest",
        "key": "ctrl+alt+backspace",
        "mac": "ctrl+cmd+backspace",
        "when": "agentSessionMonitor.openRequest == 'approval'"
      }
    ]
  }
}
